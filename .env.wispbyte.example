# ==============================================================================
# God's Eye View — Wispbyte / Lightweight Cloud Hosting Configuration
# ==============================================================================

# Host & Security Controls
GEV_ALLOWED_HOSTS=your-subdomain.wisp.uno,node.wispbyte.com
GEV_ALLOW_ALL_HOSTS=false
GEV_KEY_SETUP_TRUSTED_PEERS=none

# Memory Limit (keeps Node under Wispbyte's 512 MB RAM ceiling)
NODE_OPTIONS=--max-old-space-size=400
PUPPETEER_SKIP_DOWNLOAD=true

# Safe Default Rate Limits
GEV_RATELIMIT_GOOGLE_PER_MIN=120
GEV_RATELIMIT_OPENAI_PER_MIN=30
GEV_RATELIMIT_OPENAI_CHAT_PER_MIN=30
GEV_RATELIMIT_GEMINI_CHAT_PER_MIN=30
TOMTOM_DAILY_TILE_BUDGET=6000

# Safe Client Vessel Limits
VITE_AIS_LIVE_API_URL=/api/vessels
VITE_AIS_LIVE_MAX_ROWS=12000
VITE_AIS_LIVE_LABEL_MAX_ROWS=900

# Optional Free API Keys (leave blank for keyless defaults)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
AISSTREAM_API_KEY=
FIRMS_MAP_KEY=
MAPILLARY_CLIENT_TOKEN=
